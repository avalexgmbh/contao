{
    "name": "avalexgmbh/contao",
    "type": "contao-bundle",
    "description": "The avalex extension allows to display automatically generated and updated legal texts like „imprint“, „data privacy statement” and (if purchased) „cancellation notice“ and „terms and conditions“ within a Contao website.",
    "keywords": ["contao", "avalex", "dsgvo", "gdpr", "imprint", "impressum", "privacy policy", "datenschutzerklärung", "legal texts"],
    "license": "LGPL-3.0-or-later",
    "authors": [{
            "name": "numero2 - Agentur für digitales Marketing GbR",
            "homepage": "https://www.numero2.de"
        },
        {
            "name": "avalex GmbH",
            "homepage": "https://avalex.de/"
        }
    ],
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^5.3 || ^6.0",
        "doctrine/dbal": "^3.6 || ^4.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client-contracts": "^3.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation-contracts": "^3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "shipmonk/composer-dependency-analyser": "^1.4"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "extra": {
        "contao-manager-plugin": "numero2\\AvalexBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "numero2\\AvalexBundle\\": "src/"
        }
    },
    "scripts": {
        "depcheck": "@php vendor/bin/composer-dependency-analyser --config=depcheck.php"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "php-http/discovery": false,
            "contao/manager-plugin": false
        }
    }
}
